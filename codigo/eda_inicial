import rasterio
import matplotlib.pyplot as plt
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.colors

# Ruta de archivo 
image_path = 'https://drive.google.com/file/d/1N7PfRP1D23MFeSO3IA44jLBxlDts5Or3/view?usp=drive_link'

# Carga de la imagen TIFF
try:
    with rasterio.open(image_path) as src:
        ndwi_image = src.read(1) # Asumiendo que la banda NDWI es la primera (puedes necesitar ajustarlo)

    # Visualización de la imagen NDWI
    plt.figure(figsize=(10, 10))
    plt.imshow(ndwi_image, cmap='viridis') # Puedes cambiar el colormap según tu preferencia
    plt.colorbar(label='Valor NDWI')
    plt.title('NDWI Bahía Blanca 11/3/2025 (Sentinel 2A)')
    plt.xlabel('Píxeles (columnas)')
    plt.ylabel('Píxeles (filas)')
    plt.show()

except rasterio.errors.RasterioIOError:
    print(f"Error: No se pudo abrir o leer el archivo en {image_path}. Asegúrate de que la ruta es correcta y el archivo existe.")
except Exception as e:
    print(f"Ocurrió un error: {e}")
    
# Definición de las coordenadas de la ROI
manual_roi_coords = (800, 900, 500, 700)

print(f"Coordenadas de la ROI definidas manualmente: {manual_roi_coords}")

# Extracción de la sección de la imagen NDWI utilizando las coordenadas de la ROI
if manual_roi_coords:
    y_min, y_max, x_min, x_max = manual_roi_coords
    # Asegurarse de que las coordenadas estén dentro de los límites de la imagen
    y_min = max(0, y_min)
    y_max = min(ndwi_image.shape[0], y_max)
    x_min = max(0, x_min)
    x_max = min(ndwi_image.shape[1], x_max)

    ndwi_manual_roi_image = ndwi_image[y_min:y_max, x_min:x_max]

    print("Sección de la imagen NDWI extraída manualmente.")
    # Trabajo con ndwi_manual_roi_image, que contiene solo la ROI 
else:
    ndwi_manual_roi_image = None
    print("No se pudo extraer la sección de la imagen NDWI porque no se definieron coordenadas de la ROI.")
# Visualización de la sección de la imagen NDWI extraída manualmente
if ndwi_manual_roi_image is not None:
    plt.figure(figsize=(8, 8))
    plt.imshow(ndwi_manual_roi_image, cmap='viridis') # Puedes usar el mismo colormap u otro
    plt.colorbar(label='Valor NDWI')
    plt.title('Sección de la ROI extraída manualmente')
    plt.xlabel('Píxeles (columnas)')
    plt.ylabel('Píxeles (filas)')
    plt.show()
else:
    print("No hay una sección de la imagen NDWI extraída manualmente para visualizar.")

# Definición de las nuevas etiquetas y los rangos de NDWI
# Considerando que "con agua" puede ser "agua" y "sin agua" puede ser "no agua"
etiquetas_agua_no_agua = {
    'agua': (0.5, 1.0), # Umbral ajustado a 0.5
    'no agua': (-1.0, 0.5) 
}

# Creación de una matriz vacía para almacenar las nuevas etiquetas
etiquetas_roi_agua_no_agua = np.empty(ndwi_manual_roi_image.shape, dtype=object)

# Iteración sobre cada píxel en la ROI y asignación de una etiqueta
for i in range(etiquetas_roi_agua_no_agua.shape[0]):
    for j in range(etiquetas_roi_agua_no_agua.shape[1]):
        ndwi_valor = ndwi_manual_roi_image[i, j]

        etiqueta_asignada = 'Desconocido' 

        for etiqueta, (min_val, max_val) in etiquetas_agua_no_agua.items():
            if min_val <= ndwi_valor < max_val: # Uso de < max_val para evitar superposiciones en los límites
                etiqueta_asignada = etiqueta
                break
            # Manejo del caso del límite superior explícitamente si max_val es 1.0
            if etiqueta == 'agua' and max_val == 1.0 and ndwi_valor == 1.0:
                 etiqueta_asignada = etiqueta
                 break


        etiquetas_roi_agua_no_agua[i, j] = etiqueta_asignada

print("Etiquetado de píxeles en la ROI con categorías agua/no agua completado (umbral 0.2).")

# --- Visualización de la ROI etiquetada ---

# Mapeo de las etiquetas a valores numéricos
etiquetas_unicas_agua_no_agua = list(etiquetas_agua_no_agua.keys())
num_etiquetas_agua_no_agua = len(etiquetas_unicas_agua_no_agua)
etiqueta_a_numero_agua_no_agua = {etiqueta: i for i, etiqueta in enumerate(etiquetas_unicas_agua_no_agua)}

# Creación de una matriz numérica a partir de las nuevas etiquetas de la ROI
etiquetas_numericas_roi_agua_no_agua = np.zeros(etiquetas_roi_agua_no_agua.shape, dtype=int)
for i in range(etiquetas_roi_agua_no_agua.shape[0]):
    for j in range(etiquetas_roi_agua_no_agua.shape[1]):
        etiqueta = etiquetas_roi_agua_no_agua[i, j]
        if etiqueta in etiqueta_a_numero_agua_no_agua:
            etiquetas_numericas_roi_agua_no_agua[i, j] = etiqueta_a_numero_agua_no_agua[etiqueta]
        else:
             etiquetas_numericas_roi_agua_no_agua[i, j] = -1 # Para etiquetas desconocidas


# Definición de los colores para cada nueva etiqueta
colores_agua_no_agua = plt.cm.get_cmap('Blues', num_etiquetas_agua_no_agua) # Usamos un colormap que sugiere agua

# Creación de una lista de ticks para la barra de color
ticks_agua_no_agua = [i for i in range(num_etiquetas_agua_no_agua)]

# Visualización de la imagen con las nuevas etiquetas
plt.figure(figsize=(8, 8))
plt.imshow(etiquetas_numericas_roi_agua_no_agua, cmap=colores_agua_no_agua)
cbar_agua_no_agua = plt.colorbar(ticks=ticks_agua_no_agua)
cbar_agua_no_agua.ax.set_yticklabels(etiquetas_unicas_agua_no_agua) # Establecer las etiquetas de la barra de color
plt.title('ROI Etiquetada: Agua vs No Agua (NDWI con umbral 0.5)')
plt.xlabel('Píxeles (columnas)')
plt.ylabel('Píxeles (filas)')
plt.show()
